# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# The backend has no fallback defaults for DATABASE_URL or JWT_SECRET — it
# refuses to start without them. That is deliberate: the previous defaults
# ("change-me", a local SQLite path) let a misconfigured deployment boot and
# look healthy.

# --- PostgreSQL (used by docker compose to provision the db service) ---
POSTGRES_USER=hogfarm
POSTGRES_PASSWORD=hogfarm
POSTGRES_DB=hogfarm
POSTGRES_PORT=5432

# --- Backend ---
# Host-side value, used by `make api`, `make migrate` and `make seed`.
# Inside docker compose the api/migrate services override the host to `db`.
DATABASE_URL=postgresql+psycopg2://hogfarm:hogfarm@localhost:5432/hogfarm

# Generate a real one:  openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# dev | test | prod — dev relaxes CORS and enables API docs.
APP_ENV=dev

# Comma-separated. The Next.js dashboard proxies server-side, so the browser
# never calls the API cross-origin; this exists for direct /docs access.
CORS_ORIGINS=http://localhost:3000

# SQLAlchemy pool sizing — keep pool_size >= uvicorn worker count.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Web dashboard (Next.js) ---
# Server-side only. There is intentionally no NEXT_PUBLIC_* API URL: the
# browser talks only to Next, which proxies to FastAPI.
API_INTERNAL_URL=http://127.0.0.1:8000
