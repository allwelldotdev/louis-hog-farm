# --- Mobile app (Expo) ---
#
# Expo reads this file from the PROJECT root — this directory, `mobile/`, not
# the repository root. Copy it to `mobile/.env`.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle by Metro and are
# readable by anyone holding the app. Never put a secret here.

# Base URL of the FastAPI backend, WITHOUT the /api/v1 suffix.
#
# This must be an address the PHONE can reach. `localhost` refers to the phone
# itself, so it never works — use this machine's LAN address:
#
#     hostname -I | awk '{print $1}'      ->  e.g. 10.185.45.98
#     EXPO_PUBLIC_API_URL=http://10.185.45.98:8000
#
# `make api` binds 0.0.0.0 so the port is reachable from the LAN.
#
# Left blank, the app falls back to the host it downloaded the Metro bundle
# from (on port 8000), which is correct for a normal `make mobile` + Expo Go
# session. Either way it can be overridden on the device from the sign-in
# screen or Settings -> Server address.
EXPO_PUBLIC_API_URL=
