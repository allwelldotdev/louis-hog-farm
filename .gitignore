# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
*.db
*.sqlite
*.sqlite3

# --- Alembic ---
# (versions/ are migration source and must stay tracked; nothing to ignore here)

# --- Node / web-dashboard ---
node_modules/
web-dashboard/.next/
web-dashboard/next-env.d.ts

# Playwright MCP drops screenshots and page snapshots here when the dashboard is
# driven for verification or Chapter 4 evidence. Working artefacts, not sources.
.playwright-mcp/
web-dashboard/.tsbuildinfo
web-dashboard/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Mobile (Expo / React Native) ---
# The bulk of the mobile ignores live in mobile/.gitignore, which is Expo's own
# and stays in step with the SDK. Repeated here only where it matters that a
# stray build never reaches a commit from the repo root.
mobile/.expo/
mobile/expo-env.d.ts
mobile/android/
mobile/ios/
mobile/*.tsbuildinfo
*.keystore
*.jks

# --- Docker ---
*.pid

# --- Editors / OS ---
.vscode/*
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Logs ---
*.log
